# Never commit a real .env file.
SCRATCH_USERNAME=YourBotAccount
SCRATCH_SESSION_STRING=paste_generated_session_string_here
GROQ_API_KEY=gsk_your_key_here
ALLOWED_USERS=
AUDIENCE_MODE=everyone

# observe = read only; simulate = generate and log; private = post replies
BOT_MODE=simulate
GROQ_MODEL=llama-3.1-8b-instant
MAX_REPLY_CHARS=500
PERSONA_FILE=persona.txt
