# Never commit a real .env file.
SCRATCH_USERNAME=YourBotAccount
SCRATCH_SESSION_STRING=paste_generated_session_string_here
GROQ_API_KEY=gsk_your_key_here
MISTRAL_API_KEY=paste_your_mistral_key_here
ALLOWED_USERS=
AUDIENCE_MODE=everyone

# observe = read only; simulate = generate and log; private = post replies
BOT_MODE=simulate
AI_PROVIDER=groq
GROQ_MODEL=qwen/qwen3.6-27b
MISTRAL_MODEL=mistral-medium-3-5
MISTRAL_AGENT_ID=
MAX_REPLY_CHARS=500
PERSONA_FILE=persona.txt

# At most three new opted-in profile conversations per day.
OUTREACH_ENABLED=false
OUTREACH_USERS_FILE=config/outreach_users.txt
OUTREACH_INTERVAL_MINUTES=480

# Notifications are checked every run. Periodic recovery scanning is opt-in.
FULL_SCAN_ENABLED=false
FULL_SCAN_INTERVAL_MINUTES=360
